# Yandex Music Token (получить через x_token, см. README)
MUSIC_TOKEN=your_music_token_here
# Device ID (получить через --list-devices)
DEVICE_ID=your_device_id_here
# Device Platform (например: yandexmini_2, yandexstation_2)
DEVICE_PLATFORM=yandexmini_2
# Station IP (автообнаружение через mDNS или вручную)
STATION_IP=
# Auto-managed (не редактировать)
CONVERSATION_TOKEN=
CONVERSATION_TOKEN_EXPIRES=
